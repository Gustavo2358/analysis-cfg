     def test_07_registry_drift(self):
         ident = self.ensure_active_work()
-        self.edit_json('docs/work/registry.json', lambda x: next(
-            item for item in x['active'] if item['id'] == ident).update(status='blocked'))
-        self.assert_guard('Work registry mismatch')
+        work_path = 'docs/work/active/' + ident + '/work-item.json'
+        registry_path = 'docs/work/registry.json'
+        diagnostic = 'Work registry mismatch status: ' + ident
+
+        def registry_entry():
+            return next(item for item in load_json(self.root / registry_path)['active']
+                        if item['id'] == ident)
+
+        for original in ('active', 'blocked'):
+            with self.subTest(matched_status=original):
+                # Control both starting states in the temporary fixture only.
+                self.edit_json(work_path, lambda work: work.update(status=original))
+                self.edit_json(registry_path, lambda registry: next(
+                    item for item in registry['active'] if item['id'] == ident
+                ).update(status=original))
+                self.assertEqual(original, load_json(self.root / work_path)['status'])
+                self.assertEqual(original, registry_entry()['status'])
+                self.assertNotIn(diagnostic, validate(self.root))
+
+                work_bytes = (self.root / work_path).read_bytes()
+                work_status = load_json(self.root / work_path)['status']
+                mutated = 'active' if work_status == 'blocked' else 'blocked'
+                self.assertIn(mutated, ('active', 'blocked'))
+                self.edit_json(registry_path, lambda registry: next(
+                    item for item in registry['active'] if item['id'] == ident
+                ).update(status=mutated))
+                self.assertEqual(work_bytes, (self.root / work_path).read_bytes())
+                self.assertNotEqual(load_json(self.root / work_path)['status'],
+                                    registry_entry()['status'],
+                                    'registry drift adversarial was not constructed')
+                self.assertIn(diagnostic, validate(self.root))
 
